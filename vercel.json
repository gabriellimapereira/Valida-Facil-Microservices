{
    "services": {
        "frontend": {
            "root": "frontend",
            "framework": "vite",
            "rewrites": [
                {
                    "source": "/(.*)",
                    "destination": "/index.html"
                }
            ]
        },
        "api-gateway": {
            "root": ".",
            "entrypoint": "api-gateway/gateway/main.py"
        }
    },
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": {
                "service": "api-gateway"
            }
        },
        {
            "source": "/api",
            "destination": {
                "service": "api-gateway"
            }
        },
        {
            "source": "/(.*)",
            "destination": {
                "service": "frontend"
            }
        }
    ],
    "crons": [
        {
            "path": "/api/alerts/cron-expiry-check",
            "schedule": "0 10 * * *"
        }
    ]
}
