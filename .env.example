# Banco local: cada microsserviço possui uma instância PostgreSQL independente.
IDENTITY_DATABASE_URL=postgresql://valida_identity:local_identity_password@localhost:5435/valida_identity
WAREHOUSE_DATABASE_URL=postgresql://valida_warehouse:local_warehouse_password@localhost:5433/valida_warehouse
STORES_DATABASE_URL=postgresql://valida_stores:local_stores_password@localhost:5434/valida_stores

# Segredo usado para assinar JWT nativo (troque antes de qualquer ambiente compartilhado)
JWT_SECRET=troque-por-um-segredo-jwt-forte

# Frontend Vite
VITE_API_BASE_URL=http://localhost:8000

# URLs HTTP dos microsserviços locais.
IDENTITY_SERVICE_URL=http://localhost:8001
WAREHOUSE_SERVICE_URL=http://localhost:8002
STORES_SERVICE_URL=http://localhost:8003

# Seguranca e Integracoes
INTERNAL_SERVICE_SECRET=troque-por-um-segredo-interno-forte
CRON_SECRET=troque-por-um-segredo-cron-forte
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173
ENVIRONMENT=development

# Credenciais locais dos bancos e broker
DB_IDENTITY_USER=valida_identity
DB_IDENTITY_PASSWORD=local_identity_password
DB_WAREHOUSE_USER=valida_warehouse
DB_WAREHOUSE_PASSWORD=local_warehouse_password
DB_STORES_USER=valida_stores
DB_STORES_PASSWORD=local_stores_password
RABBITMQ_USER=validafacil
RABBITMQ_PASS=validafacil123

# E-mail SMTP (MS Warehouse - Alertas de Vencimento)
SMTP_HOST=smtp.seu-provedor.com
SMTP_PORT=587
SMTP_USER=seu-usuario-smtp
SMTP_PASSWORD=sua-senha-smtp
SMTP_FROM_EMAIL=alertas@validafacil.com
SMTP_FROM_NAME=Valida Facil

# Broker (Docker Compose fornece o endereço interno do RabbitMQ)
RABBITMQ_URL=
